<IfModule mod_authz_core.c>
	<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|json|lock|log|orig|phar|psd|sh|sql|sw[op])|~)$">
		Require all denied
	</FilesMatch>
	<FilesMatch "vendor">
		Require all denied
	</FilesMatch>
</IfModule>

RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule . index.php [L]
